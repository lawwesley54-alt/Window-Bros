//@version=6
// Buy at the close of the day's last candle if it is red (long only).
// Close the long at the next morning's OPEN (9:30 AM).
// Dates: all of November and December, every year from 2021 to 2025. $10,000 per trade.
// Use on AMZN, 1-hour chart. Only regular hours (9:30 AM - 4:00 PM) are used.
// Details:
//   - Every trade gets a small label with its profit. Hover over it to see
//     the buy date/price, sell date/price and number of shares.
//   - A summary label on the latest candle lists each year and the total.
indicator("Red Close Overnight Backtest", overlay = true, max_labels_count = 500)

tz  = "America/New_York"
mo  = month(time, tz)
dom = dayofmonth(time, tz)

// November and December, 2021 through 2025
yr       = year(time, tz)
inWindow = yr >= 2021 and yr <= 2025 and (mo == 11 or mo == 12)

// Last candle of the day: closes at 4:00 PM, or 1:00 PM on the half days
// (the Friday after Thanksgiving, and Dec 24).
closeMin = hour(time_close, tz) * 60 + minute(time_close, tz)
halfDay  = (mo == 11 and dayofweek(time, tz) == dayofweek.friday and dom >= 23 and dom <= 29) or (mo == 12 and dom == 24)
isMarket = session.ismarket
lastBar  = isMarket and (closeMin == 16 * 60 or (halfDay and closeMin == 13 * 60))
// First regular-hours candle of a new day; its open is the 9:30 AM open
firstBar = isMarket and (not isMarket[1] or dayofmonth(time[1], tz) != dom)
isRed    = close < open

money(x) => (x >= 0 ? "+" : "") + str.tostring(x, "$#,##0.00")

var float entryPrice = na
var int   entryTime  = 0
var float shares     = 0.0
var int   entryYear  = 0
var yProfit = array.new_float(5, 0.0)
var yTrades = array.new_int(5, 0)
var yWins   = array.new_int(5, 0)

// Close the long at the morning open
if firstBar and not na(entryPrice)
    p = shares * (open - entryPrice)
    i = entryYear - 2021
    array.set(yProfit, i, array.get(yProfit, i) + p)
    array.set(yTrades, i, array.get(yTrades, i) + 1)
    if p > 0
        array.set(yWins, i, array.get(yWins, i) + 1)
    tip = "Bought " + str.format_time(entryTime, "MMM d, yyyy", tz) + " at close: $" + str.tostring(entryPrice, "#,##0.00") +
         "\nSold " + str.format_time(time, "MMM d, yyyy", tz) + " at 9:30 open: $" + str.tostring(open, "#,##0.00") +
         "\nShares: " + str.tostring(shares) +
         "\nProfit: " + money(p)
    label.new(bar_index, high, money(p), style = label.style_label_down, color = p >= 0 ? color.green : color.red, textcolor = color.white, size = size.small, tooltip = tip)
    entryPrice := na

// Open a long position at the close of a red last candle
buySignal = inWindow and lastBar and isRed and na(entryPrice)
if buySignal
    entryPrice := close
    entryTime  := time
    shares     := math.floor(10000 / close)
    entryYear  := yr

// Show the buy points on the chart, and shade the test dates
plotshape(buySignal, "Buy point", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white, size = size.small)
bgcolor(inWindow ? color.new(color.blue, 90) : na, title = "Test dates")

// Summary for every year, shown on the latest candle
if barstate.islast
    txt  = syminfo.ticker + " - Nov & Dec, $10,000 per trade\n"
    totP = 0.0
    totT = 0
    totW = 0
    for i = 0 to 4
        t = array.get(yTrades, i)
        p = array.get(yProfit, i)
        w = array.get(yWins, i)
        totP += p
        totT += t
        totW += w
        txt += "\n" + str.tostring(2021 + i) + ":  " + (t > 0 ? money(p) + "  |  " + str.tostring(t) + " trades  |  " + str.tostring(100.0 * w / t, "#") + "% wins" : "no data loaded")
    txt += "\n\nTOTAL:  " + money(totP) + "  |  " + str.tostring(totT) + " trades  |  " + (totT > 0 ? str.tostring(100.0 * totW / totT, "#") : "0") + "% wins"
    label.new(bar_index, high, txt, style = label.style_label_left, color = totP >= 0 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, textalign = text.align_left)
