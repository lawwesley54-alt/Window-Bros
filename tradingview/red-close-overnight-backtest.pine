//@version=6
// Buy at the close of the day's last candle if it is red.
// Sell at the close of the next day's first candle.
// Dates: Nov 24 to Dec 24 of every year from 2021 to 2025. $10,000 per trade.
// Use on AMZN, 1-hour chart, regular trading hours.
strategy("Red Close Overnight Backtest", overlay = true, initial_capital = 10000, process_orders_on_close = true)

tz  = "America/New_York"
yr  = year(time, tz)
mo  = month(time, tz)
dom = dayofmonth(time, tz)

// Nov 24 - Dec 24, 2021 through 2025
inWindow = yr >= 2021 and yr <= 2025 and ((mo == 11 and dom >= 24) or (mo == 12 and dom <= 24))

// Last candle of the day: closes at 4:00 PM, or 1:00 PM on the half days
// (the Friday after Thanksgiving, and Dec 24).
closeMin = hour(time_close, tz) * 60 + minute(time_close, tz)
halfDay  = (mo == 11 and dayofweek(time, tz) == dayofweek.friday and dom >= 23 and dom <= 29) or (mo == 12 and dom == 24)
lastBar  = closeMin == 16 * 60 or (halfDay and closeMin == 13 * 60)
firstBar = session.isfirstbar_regular
isRed    = close < open

// Buy
if inWindow and lastBar and isRed and strategy.position_size == 0
    strategy.entry("Buy", strategy.long, qty = math.floor(10000 / close))

// Sell
if firstBar and strategy.position_size > 0
    strategy.close("Buy", comment = "Sell")

// Add up results for each year (2021 = row 0 ... 2025 = row 4)
var profits = array.new_float(5, 0.0)
var trades  = array.new_int(5, 0)
var wins    = array.new_int(5, 0)
var int counted = 0
if strategy.closedtrades > counted
    for i = counted to strategy.closedtrades - 1
        idx = year(strategy.closedtrades.entry_time(i), tz) - 2021
        if idx >= 0 and idx < 5
            p = strategy.closedtrades.profit(i)
            array.set(profits, idx, array.get(profits, idx) + p)
            array.set(trades, idx, array.get(trades, idx) + 1)
            if p > 0
                array.set(wins, idx, array.get(wins, idx) + 1)
    counted := strategy.closedtrades

// Results table
var table t = table.new(position.top_right, 4, 7, bgcolor = color.new(color.black, 15))
if barstate.islast
    table.cell(t, 0, 0, "Year", text_color = color.white)
    table.cell(t, 1, 0, "Trades", text_color = color.white)
    table.cell(t, 2, 0, "Win rate", text_color = color.white)
    table.cell(t, 3, 0, "Profit", text_color = color.white)
    for i = 0 to 4
        n = array.get(trades, i)
        p = array.get(profits, i)
        table.cell(t, 0, i + 1, str.tostring(2021 + i), text_color = color.white)
        table.cell(t, 1, i + 1, str.tostring(n), text_color = color.white)
        table.cell(t, 2, i + 1, n > 0 ? str.tostring(100.0 * array.get(wins, i) / n, "#") + "%" : "-", text_color = color.white)
        table.cell(t, 3, i + 1, n > 0 ? str.tostring(p, "$#,##0.00") : "no data", text_color = p >= 0 ? color.lime : color.red)
    table.cell(t, 0, 6, "Total", text_color = color.white)
    table.cell(t, 1, 6, str.tostring(strategy.closedtrades), text_color = color.white)
    table.cell(t, 2, 6, strategy.closedtrades > 0 ? str.tostring(100.0 * strategy.wintrades / strategy.closedtrades, "#") + "%" : "-", text_color = color.white)
    table.cell(t, 3, 6, str.tostring(strategy.netprofit, "$#,##0.00"), text_color = strategy.netprofit >= 0 ? color.lime : color.red)
