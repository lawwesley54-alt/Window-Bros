//@version=6
// Red Close Overnight Backtest
// ---------------------------------------------------------------------------
// Rules (use on an INTRADAY chart, e.g. AMZN 1-hour, regular trading hours):
//   BUY  at the close of the LAST candle of the trading day, only if that
//        candle is red (close < open).
//   SELL at the close of the FIRST candle of the next trading day.
// Only entries inside the chosen date window are taken. Starting capital is
// $10,000 and each trade buys as many whole shares as the capital allows.
// ---------------------------------------------------------------------------
strategy("Red Close Overnight Backtest",
     overlay = true,
     initial_capital = 10000,
     currency = currency.USD,
     process_orders_on_close = true,
     commission_type = strategy.commission.cash_per_order,
     commission_value = 0,
     pyramiding = 0)

// ---- Inputs ----------------------------------------------------------------
startDate = input.time(timestamp("America/New_York", 2025, 11, 17, 0, 0), "Start date", group = "Test window")
endDate   = input.time(timestamp("America/New_York", 2025, 12, 31, 23, 59), "End date", group = "Test window")
capital   = input.float(10000, "Amount invested per trade ($)", minval = 1, group = "Sizing")
compound  = input.bool(false, "Compound (reinvest gains/losses each trade)", group = "Sizing")
showTable = input.bool(true, "Show results table", group = "Display")

// ---- Signals ---------------------------------------------------------------
inWindow  = time >= startDate and time <= endDate
isRed     = close < open
lastBar   = session.islastbar_regular
firstBar  = session.isfirstbar_regular

// Shares to buy: fixed $ amount, or current equity if compounding
cashToUse = compound ? strategy.equity : capital
qty       = math.floor(cashToUse / close)

// ---- Entry: close of the day's last candle, if it is red ------------------
if inWindow and lastBar and isRed and strategy.position_size == 0 and qty > 0
    strategy.entry("Buy red close", strategy.long, qty = qty)

// ---- Exit: close of the first candle of the next day ----------------------
if firstBar and strategy.position_size > 0
    strategy.close("Buy red close", comment = "Sell 1st candle")

// ---- Visuals ---------------------------------------------------------------
bgcolor(inWindow ? color.new(color.blue, 94) : na, title = "Test window")
plotshape(inWindow and lastBar and isRed, "Red last candle", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.tiny)

// ---- Results table ---------------------------------------------------------
var table t = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 15), border_width = 1)
if showTable and barstate.islast
    wins    = strategy.wintrades
    total   = strategy.closedtrades
    winRate = total > 0 ? 100.0 * wins / total : 0.0
    table.cell(t, 0, 0, "Starting capital", text_color = color.white)
    table.cell(t, 1, 0, str.tostring(strategy.initial_capital, "$#,##0.00"), text_color = color.white)
    table.cell(t, 0, 1, "Net profit", text_color = color.white)
    table.cell(t, 1, 1, str.tostring(strategy.netprofit, "$#,##0.00"), text_color = strategy.netprofit >= 0 ? color.lime : color.red)
    table.cell(t, 0, 2, "Ending balance", text_color = color.white)
    table.cell(t, 1, 2, str.tostring(strategy.initial_capital + strategy.netprofit, "$#,##0.00"), text_color = color.white)
    table.cell(t, 0, 3, "Return", text_color = color.white)
    table.cell(t, 1, 3, str.tostring(100.0 * strategy.netprofit / strategy.initial_capital, "#.##") + "%", text_color = color.white)
    table.cell(t, 0, 4, "Trades", text_color = color.white)
    table.cell(t, 1, 4, str.tostring(total), text_color = color.white)
    table.cell(t, 0, 5, "Win rate", text_color = color.white)
    table.cell(t, 1, 5, str.tostring(winRate, "#.#") + "%", text_color = color.white)
    table.cell(t, 0, 6, "Open position", text_color = color.white)
    table.cell(t, 1, 6, strategy.position_size > 0 ? "Yes" : "No", text_color = color.white)
