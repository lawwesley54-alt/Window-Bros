//@version=6
// Buy at the close of the day's last candle if it is red.
// Sell at the close of the next day's first candle.
// Dates: all of November and December, every year from 2021 to 2025. $10,000 per trade.
// Use on AMZN, 1-hour chart. Only regular hours (9:30 AM - 4:00 PM) are used.
// Results: Strategy Tester tab, plus a label on the chart for each year.
strategy("Red Close Overnight Backtest", overlay = true, initial_capital = 10000, process_orders_on_close = true, max_labels_count = 100)

// Long positions only: the strategy can never sell short
strategy.risk.allow_entry_in(strategy.direction.long)

tz  = "America/New_York"
mo  = month(time, tz)
dom = dayofmonth(time, tz)

// November and December, 2021 through 2025
yr       = year(time, tz)
inWindow = yr >= 2021 and yr <= 2025 and (mo == 11 or mo == 12)

// Last candle of the day: closes at 4:00 PM, or 1:00 PM on the half days
// (the Friday after Thanksgiving, and Dec 24).
closeMin = hour(time_close, tz) * 60 + minute(time_close, tz)
halfDay  = (mo == 11 and dayofweek(time, tz) == dayofweek.friday and dom >= 23 and dom <= 29) or (mo == 12 and dom == 24)
isMarket = session.ismarket
lastBar  = isMarket and (closeMin == 16 * 60 or (halfDay and closeMin == 13 * 60))
// First regular-hours candle of a new day (ignores pre-market and after-hours)
firstBar = isMarket and (not isMarket[1] or dayofmonth(time[1], tz) != dom)
isRed    = close < open

buySignal  = inWindow and lastBar and isRed and strategy.position_size == 0
sellSignal = firstBar and strategy.position_size > 0

// Buy
if buySignal
    strategy.entry("Buy", strategy.long, qty = math.floor(10000 / close))

// Sell
if sellSignal
    strategy.close("Buy", comment = "Sell")

// Show only the buy points on the chart, and shade the test dates.
// (The sell still happens in the background so profit can be measured.)
plotshape(buySignal, "Buy point", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white, size = size.small)
bgcolor(inWindow ? color.new(color.blue, 90) : na, title = "Test dates")

// One label per year showing that year's profit and number of trades
var float yProfit = 0.0
var int   yTrades = 0
var int   yYear   = 0
var label yLabel  = na
var int   counted = 0
if strategy.closedtrades > counted
    for i = counted to strategy.closedtrades - 1
        ey = year(strategy.closedtrades.entry_time(i), tz)
        if ey != yYear
            yYear   := ey
            yProfit := 0.0
            yTrades := 0
            yLabel  := label.new(bar_index, high, "", style = label.style_label_down, textcolor = color.white)
        yProfit += strategy.closedtrades.profit(i)
        yTrades += 1
    counted := strategy.closedtrades
    label.set_text(yLabel, str.tostring(yYear) + ": " + (yProfit >= 0 ? "+" : "") + str.tostring(yProfit, "$#,##0") + " (" + str.tostring(yTrades) + " trades)")
    label.set_xy(yLabel, bar_index, high)
    label.set_color(yLabel, yProfit >= 0 ? color.green : color.red)
