//@version=6
// Red Close Overnight Backtest - 12 Months (long only, bigger-payout version)
// Every trading day of a 12-month period. "Which year to test" in the
// settings picks the period: 0 = last 12 months, 1 = the year before that.
//
// BASE RULE:
//   BUY  at the close of the day's last 1-hour candle, if that candle is red.
//   SELL when the next morning's first 1-hour candle closes (about 10:30 AM).
// Starts with $10,000. Use on a 1-hour chart, regular trading hours.
//
// BIGGER PAYOUT (MORE RISK) - each one can be turned on/off in the settings:
//   1. Let winners run: if the morning's first candle is green, keep holding
//      until a candle turns red or the day ends.
//   2. Bet bigger on bigger drops: if the last candle fell 0.5% or more,
//      buy 150% of the account instead of 100% (uses margin).
//   3. Also buy green nights, at 50% size.
//   4. Buy more on red streaks: 2 red days in a row = 1.5x size,
//      3 or more = 2x size.
//   Size is capped at 200% of the account.
//
// TRADE HISTORY: Strategy Tester tab > List of Trades. Hover over a BUY tag
// to see why it bought that size.
strategy("Red Close Overnight - 12 Months", overlay = true, initial_capital = 10000, process_orders_on_close = true, margin_long = 50, max_labels_count = 500)

// Long positions only: the strategy can never sell short
strategy.risk.allow_entry_in(strategy.direction.long)

// ---- Settings ----
reinvest  = input.bool(true, "Reinvest winnings (trade size grows or shrinks with the account)")
yearsAgo  = input.int(1, "Which year to test", minval = 0, maxval = 5, tooltip = "0 = the last 12 months\n1 = the 12 months before that (13-24 months ago)\n2 = 25-36 months ago, and so on")
minDrop   = input.float(0.0, "Minimum drop in the last candle (%)", minval = 0, step = 0.1, tooltip = "0 = any red candle")
G         = "Bigger payout (more risk)"
letRun    = input.bool(true, "1. Let winners run (hold while the morning is green)", group = G)
bigBet    = input.bool(true, "2. Bet bigger on bigger drops", group = G)
bigDrop   = input.float(0.5, "    drop of at least %", minval = 0.1, step = 0.1, group = G, inline = "big")
bigSize   = input.int(150, "buy % of account", minval = 100, maxval = 200, step = 10, group = G, inline = "big")
greenOn   = input.bool(true, "3. Also buy green nights", group = G, inline = "green")
greenSize = input.int(50, "buy % of account", minval = 10, maxval = 200, step = 10, group = G, inline = "green")
streakOn  = input.bool(true, "4. Buy more on red streaks (2 days = 1.5x, 3+ days = 2x)", group = G)
maxSize   = input.int(200, "Never buy more than % of account", minval = 50, maxval = 200, step = 10, group = G)

// Only run on a 1-hour chart
rightTF = timeframe.period == "60"

// ---- The 12-month period being tested ----
tz        = "America/New_York"
YEAR      = 365 * 86400000
endTime   = timenow - yearsAgo * YEAR
startTime = endTime - YEAR
inWindow  = rightTF and time >= startTime and time < endTime
period    = str.format_time(startTime, "MMM d, yyyy", tz) + " - " + str.format_time(endTime, "MMM d, yyyy", tz)
mo        = month(time, tz)
dom       = dayofmonth(time, tz)
dow       = dayofweek(time, tz)

// ---- Candles ----
// Last candle of the day: closes at 4:00 PM, or 1:00 PM on the half days
// (the Friday after Thanksgiving, and Dec 24).
closeMin = hour(time_close, tz) * 60 + minute(time_close, tz)
halfDay  = (mo == 11 and dow == dayofweek.friday and dom >= 23 and dom <= 29) or (mo == 12 and dom == 24)
isMarket = session.ismarket
lastBar  = isMarket and (closeMin == 16 * 60 or (halfDay and closeMin == 13 * 60))
// First regular-hours candle of a new day
firstBar = isMarket and (not isMarket[1] or dayofmonth(time[1], tz) != dom)
isRed    = close < open
isGreen  = close > open
dropPct  = (open - close) / open * 100

// ---- Red-day streak (a red day = closed below where it opened) ----
var float dayOpen   = na
var int   redStreak = 0
if firstBar
    dayOpen := open
if lastBar
    redStreak := close < dayOpen ? redStreak + 1 : 0

// ---- How much to buy tonight (as a share of the account) ----
tSize = 0.0
why   = ""
if isRed and dropPct >= minDrop
    tSize := 1.0
    why   := "Red last candle (fell " + str.tostring(dropPct, "#.##") + "%) -> 100%"
    if bigBet and dropPct >= bigDrop
        tSize := bigSize / 100.0
        why   := "Big drop: last candle fell " + str.tostring(dropPct, "#.##") + "% -> " + str.tostring(bigSize) + "%"
    if streakOn and redStreak >= 2
        mult = redStreak >= 3 ? 2.0 : 1.5
        tSize *= mult
        why   += "\n" + str.tostring(redStreak) + " red days in a row -> x" + str.tostring(mult, "#.#")
else if greenOn and not isRed
    tSize := greenSize / 100.0
    why   := "Green night -> " + str.tostring(greenSize) + "%"
if tSize > maxSize / 100.0
    tSize := maxSize / 100.0
    why   += "\nCapped at " + str.tostring(maxSize) + "%"

buyTonight = inWindow and lastBar and tSize > 0
base       = reinvest ? strategy.equity : 10000
qty        = math.floor(base * tSize / close)

// ---- Selling ----
var bool riding = false
if strategy.position_size > 0
    if firstBar and not lastBar
        if letRun and isGreen
            // Morning is going up: keep holding
            riding := true
        else
            strategy.close("Long", comment = "Sell")
            riding := false
    else if riding and not lastBar and isRed
        strategy.close("Long", comment = "Sell (turned red)")
        riding := false
    else if riding and lastBar
        riding := false
        // Held all day. Keep it overnight if tonight is a buy night, otherwise sell.
        if not buyTonight
            strategy.close("Long", comment = "Sell (end of day)")

// ---- Buying ----
enter = buyTonight and strategy.position_size == 0 and qty > 0
if enter
    strategy.entry("Long", strategy.long, qty = qty)
    label.new(bar_index, low, "BUY " + str.tostring(tSize * 100, "#") + "%", style = label.style_label_up, yloc = yloc.belowbar,
         color = tSize > 1 ? color.purple : isRed ? color.green : color.teal, textcolor = color.white, size = size.small,
         tooltip = "Buying $" + str.tostring(qty * close, "#,##0") + " (" + str.tostring(qty) + " shares)\n" + why)

// ---- Results per month ----
money(x) => (x >= 0 ? "+" : "") + str.tostring(x, "$#,##0.00")
monthKey(t) => year(t, tz) * 100 + month(t, tz)

var keys = array.new_int()
var rP   = array.new_float()
var rT   = array.new_int()
var rW   = array.new_int()
var eP   = array.new_float()
var eT   = array.new_int()

slot(k, ks, a, b, c, d, e) =>
    i = array.indexof(ks, k)
    if i == -1
        array.push(ks, k)
        array.push(a, 0.0)
        array.push(b, 0)
        array.push(c, 0)
        array.push(d, 0.0)
        array.push(e, 0)
        i := array.size(ks) - 1
    i

// Every night comparison ($10,000 per trade, no rules, sell after the first candle)
var float eEntry  = na
var float eShares = 0.0
var int   eKey    = 0
if firstBar and not na(eEntry)
    i = slot(eKey, keys, rP, rT, rW, eP, eT)
    array.set(eP, i, array.get(eP, i) + eShares * (close - eEntry))
    array.set(eT, i, array.get(eT, i) + 1)
    eEntry := na
if inWindow and lastBar and na(eEntry)
    eEntry  := close
    eShares := math.floor(10000 / close)
    eKey    := monthKey(time)

// Hold comparison (start to end of the period)
var float hStart = na
var float hEnd   = na
if inWindow and isMarket
    if na(hStart)
        hStart := open
    hEnd := close

// Your trades: monthly totals and a label on every trade
var int counted = 0
if strategy.closedtrades > counted
    for k = counted to strategy.closedtrades - 1
        et = strategy.closedtrades.entry_time(k)
        p  = strategy.closedtrades.profit(k)
        i  = slot(monthKey(et), keys, rP, rT, rW, eP, eT)
        array.set(rP, i, array.get(rP, i) + p)
        array.set(rT, i, array.get(rT, i) + 1)
        if p > 0
            array.set(rW, i, array.get(rW, i) + 1)
        tip = "Bought " + str.format_time(et, "EEE MMM d, yyyy h:mm a", tz) + " at $" + str.tostring(strategy.closedtrades.entry_price(k), "#,##0.00") +
             "\nSold " + str.format_time(strategy.closedtrades.exit_time(k), "EEE MMM d, yyyy h:mm a", tz) + " at $" + str.tostring(strategy.closedtrades.exit_price(k), "#,##0.00") +
             "\nShares: " + str.tostring(strategy.closedtrades.size(k)) +
             "\nProfit: " + money(p)
        label.new(bar_index, high, money(p), style = label.style_label_down, color = p >= 0 ? color.green : color.red, textcolor = color.white, size = size.small, tooltip = tip)
    counted := strategy.closedtrades

// ---- Chart markers ----
bgcolor(inWindow ? color.new(color.blue, 94) : na, title = "Test dates")

// ---- Summary label ----
if barstate.islast and not rightTF
    label.new(bar_index, high, "WRONG TIMEFRAME\nThis test only works on the 1-hour chart.\nClick the timeframe at the top left (next to " + syminfo.ticker + ") and choose 1 hour.", style = label.style_label_left, color = color.orange, textcolor = color.white, size = size.large, textalign = text.align_left)
if barstate.islast and rightTF
    boosts = (letRun ? "let winners run, " : "") + (bigBet ? "bigger bets on big drops, " : "") + (greenOn ? "green nights, " : "") + (streakOn ? "red streaks, " : "")
    txt = (syminfo.ticker != "AMZN" ? "NOTE: this chart is " + syminfo.ticker + ", not AMZN\n" : "") +
         syminfo.ticker + " - " + period + ", " + (reinvest ? "starting with $10,000, reinvesting winnings" : "$10,000 base trade") +
         "\nRule: buy a red last candle, sell after the first candle next day" +
         "\nBigger-payout options on: " + (boosts == "" ? "none" : str.substring(boosts, 0, str.length(boosts) - 2)) + "\n"
    trP = 0.0
    trT = 0
    trW = 0
    teP = 0.0
    teT = 0
    n = array.size(keys)
    if n > 0
        for i = 0 to n - 1
            k  = array.get(keys, i)
            t  = array.get(rT, i)
            p  = array.get(rP, i)
            w  = array.get(rW, i)
            nt = array.get(eT, i)
            np = array.get(eP, i)
            trP += p
            trT += t
            trW += w
            teP += np
            teT += nt
            mName = str.format_time(timestamp(tz, math.floor(k / 100), k % 100, 15, 12, 0), "MMM yyyy", tz)
            txt += "\n" + mName + ":  YOUR RULE " + (t > 0 ? money(p) + " (" + str.tostring(t) + " trades, " + str.tostring(100.0 * w / t, "#") + "% wins)" : "no trades") +
                 "  |  EVERY NIGHT " + (nt > 0 ? money(np) : "-")
    hold = na(hStart) ? 0.0 : math.floor(10000 / hStart) * (hEnd - hStart)
    txt += "\n\nTOTAL:  YOUR RULE " + money(trP) + " (" + str.tostring(trT) + " trades, " + (trT > 0 ? str.tostring(100.0 * trW / trT, "#") : "0") + "% wins)" +
         "  |  EVERY NIGHT " + money(teP) + " (" + str.tostring(teT) + " trades)" +
         "  |  HOLD " + money(hold)
    txt += "\nFull trade history: Strategy Tester > List of Trades"
    label.new(bar_index, high, txt, style = label.style_label_left, color = trP >= 0 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, textalign = text.align_left)
